---
import { Image } from "astro:assets";
import BasicLayout from "../layouts/BasicLayout.astro";
import fa from "../images/doronifa.png";
import miyasaka from "../images/miyasakanagi_400x400.jpg";
---

<BasicLayout>
  <main>
    <h1>WORKS</h1>
    <p>寄稿・創作作品等の掲示場所。作品ごとの詳細は各ページで紹介しています。</p>

    <div class="works-list">
      <article class="work-card" id="High-Sky-Fields">
        <Image
          src={fa}
          alt="High-Sky-Fieldsのファンアート『いいね、この島も』"
          width={220}
          class="work-card__image"
        />
        <div class="work-card__body">
          <p class="work-card__category">寄稿</p>
          <h2>High-Sky-Fields</h2>
          <p>
            軌道エレベーター「きざはし」のふもとにある人工島「中ノ島」を舞台に、少女たちを描いた作品。
          </p>
          <a class="work-card__link" href="/works/high-sky-fields/">作品詳細・本文を読む →</a>
        </div>
      </article>

      <article class="work-card" id="miyasakanagi">
        <Image
          src={miyasaka}
          alt="宮坂ナギ"
          width={220}
          class="work-card__image"
        />
        <div class="work-card__body">
          <p class="work-card__category">MYCOE</p>
          <h2>宮坂ナギ</h2>
          <p>
            音声合成ソフトウェア『COEIROINK』のユーザーモデル。喫茶春夏秋冬の店員。
          </p>
          <a class="work-card__link" href="/works/miyasaka-nagi/">紹介・利用案内を見る →</a>
        </div>
      </article>
    </div>
  </main>
</BasicLayout>

<style>
  main {
    padding-bottom: 2rem;
  }

  .works-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .work-card {
    display: grid;
    grid-template-columns: minmax(120px, 36%) 1fr;
    overflow: hidden;
    border: 1px solid #9cb5cc;
    border-radius: 0.5rem;
    background: #fff;
  }

  .work-card__image {
    width: 100%;
    height: 100%;
    min-height: 220px;
    object-fit: cover;
  }

  .work-card__body {
    padding: 1rem;
  }

  .work-card__category {
    margin: 0 0 0.25rem;
    color: #4b5e70;
    font-size: 0.85rem;
    font-weight: bold;
  }

  .work-card h2 {
    margin: 0;
  }

  .work-card__link {
    display: inline-block;
    margin-top: 0.5rem;
    font-weight: bold;
  }

  @media (max-width: 600px) {
    .work-card {
      grid-template-columns: 1fr;
    }

    .work-card__image {
      height: 220px;
    }
  }
</style>
